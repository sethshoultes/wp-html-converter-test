      "url": "http://127.0.0.1:9400/",
      "stored_content": "<!-- wp:group {\"tagName\":\"main\",\"metadata\":{\"name\":\"Main\"}} --><main class=\"wp-block-group\"><!-- wp:cover {\"className\":\"hero\",\"style\":{\"color\":{\"text\":\"var(\\u002d\\u002dqf-paper)\"}},\"url\":\"http://127.0.0.1:9400/wp-content/uploads/2026/10/hero.svg\",\"alt\":\"\",\"dimRatio\":0,\"metadata\":{\"name\":\"Your bike, running like the day you got it\"},\"id\":8} --><div class=\"wp-block-cover has-text-color hero\" style=\"color:var(--qf-paper)\"><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"http://127.0.0.1:9400/wp-content/uploads/2026/10/hero.svg\" data-object-fit=\"cover\"/><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Your bike, running like the day you got it</h1><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">A small repair workshop in Larkbend. Tune-ups, wheel builds and cargo bike care, done while you wait or by the next morning.</p><!-- /wp:paragraph --><!-- wp:buttons {\"className\":\"blocks-engine-control-8a5b470bf289-0 blocks-engine-role-control blocks-engine-subject blocks-engine-subject-tag-a blocks-engine-subject-class-c3e2d78f3ff3\"} --><div class=\"wp-block-buttons blocks-engine-control-8a5b470bf289-0 blocks-engine-role-control blocks-engine-subject blocks-engine-subject-tag-a blocks-engine-subject-class-c3e2d78f3ff3\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#e9a64b\",\"text\":\"#1a2624\"},\"border\":{\"radius\":\"10px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|80\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|80\"}},\"typography\":{\"fontWeight\":\"700\"}},\"className\":\"blocks-engine-control-8a5b470bf289-0 blocks-engine-role-control blocks-engine-subject blocks-engine-subject-tag-a blocks-engine-subject-class-c3e2d78f3ff3\"} --><div class=\"wp-block-button blocks-engine-control-8a5b470bf289-0 blocks-engine-role-control blocks-engine-subject blocks-engine-subject-tag-a blocks-engine-subject-class-c3e2d78f3ff3\"><a class=\"wp-block-button__link has-text-color has-background wp-element-button\" style=\"border-radius:10px;color:#1a2624;background-color:#e9a64b;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--80);font-weight:700\" href=\"/?page_id=15\">Book a repair</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div></div><!-- /wp:cover --><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"What we do\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What we do</h2><!-- /wp:heading --><!-- wp:group {\"className\":\"cards blocks-engine-css-owned-layout blocks-engine-css-owned-grid\"} --><div class=\"wp-block-group cards blocks-engine-css-owned-layout blocks-engine-css-owned-grid\"><!-- wp:group {\"className\":\"card blocks-engine-css-owned-layout\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\",\"left\":\"var:preset|spacing|70\"}},\"border\":{\"width\":\"1px\",\"style\":\"solid\",\"color\":\"#e4ddd0\",\"radius\":\"var(\\u002d\\u002dqf-radius)\"}},\"tagName\":\"article\",\"metadata\":{\"name\":\"Tune-ups\"},\"backgroundColor\":\"accent-2\"} --><article class=\"wp-block-group has-border-color card blocks-engine-css-owned-layout has-background has-accent-2-background-color\" style=\"border-color:#e4ddd0;border-style:solid;border-width:1px;border-radius:var(--qf-radius);padding-top:var(--wp--preset--spacing--70);padding-right:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Tune-ups</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Gears indexed, brakes set, chain cleaned and every bolt checked to torque.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"var(\\u002d\\u002dqf-rust)\"}},\"className\":\"blocks-engine-synthetic-paragraph\"} --><p class=\"has-text-color blocks-engine-synthetic-paragraph\" style=\"color:var(--qf-rust)\"><a href=\"/?page_id=16#tune-ups\">See tune-up levels</a></p><!-- /wp:paragraph --></article><!-- /wp:group --><!-- wp:group {\"className\":\"card blocks-engine-css-owned-layout\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\",\"left\":\"var:preset|spacing|70\"}},\"border\":{\"width\":\"1px\",\"style\":\"solid\",\"color\":\"#e4ddd0\",\"radius\":\"var(\\u002d\\u002dqf-radius)\"}},\"tagName\":\"article\",\"metadata\":{\"name\":\"Wheels\"},\"backgroundColor\":\"accent-2\"} --><article class=\"wp-block-group has-border-color card blocks-engine-css-owned-layout has-background has-accent-2-background-color\" style=\"border-color:#e4ddd0;border-style:solid;border-width:1px;border-radius:var(--qf-radius);padding-top:var(--wp--preset--spacing--70);padding-right:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Wheels</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Truing, spoke replacement and hand-built wheels for road, gravel and town bikes.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"var(\\u002d\\u002dqf-rust)\"}},\"className\":\"blocks-engine-synthetic-paragraph\"} --><p class=\"has-text-color blocks-engine-synthetic-paragraph\" style=\"color:var(--qf-rust)\"><a href=\"/?page_id=16#wheels\">See wheel work</a></p><!-- /wp:paragraph --></article><!-- /wp:group --><!-- wp:group {\"className\":\"card blocks-engine-css-owned-layout\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\",\"left\":\"var:preset|spacing|70\"}},\"border\":{\"width\":\"1px\",\"style\":\"solid\",\"color\":\"#e4ddd0\",\"radius\":\"var(\\u002d\\u002dqf-radius)\"}},\"tagName\":\"article\",\"metadata\":{\"name\":\"Cargo bikes\"},\"backgroundColor\":\"accent-2\"} --><article class=\"wp-block-group has-border-color card blocks-engine-css-owned-layout has-background has-accent-2-background-color\" style=\"border-color:#e4ddd0;border-style:solid;border-width:1px;border-radius:var(--qf-radius);padding-top:var(--wp--preset--spacing--70);padding-right:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Cargo bikes</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Longtails and front-loaders, with the space and the stands to work on them properly.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"var(\\u002d\\u002dqf-rust)\"}},\"className\":\"blocks-engine-synthetic-paragraph\"} --><p class=\"has-text-color blocks-engine-synthetic-paragraph\" style=\"color:var(--qf-rust)\"><a href=\"/?page_id=16#cargo\">See cargo care</a></p><!-- /wp:paragraph --></article><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --></section><!-- /wp:group --><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"Open today\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Open today</h2><!-- /wp:heading --><!-- wp:html {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"open-row blocks-engine-source-p-2dd0f2ccde1c-0\">\n          <svg class=\"icon-wrench\" width=\"48\" height=\"48\" viewbox=\"0 0 48 48\" role=\"img\" aria-labelledby=\"wrench-title\">\n            \n            <circle cx=\"24\" cy=\"24\" r=\"22\" fill=\"#e9a64b\"></circle>\n            <path d=\"M30 10a8 8 0 0 0-7.6 10.4L11 31.8 16.2 37l11.4-11.4A8 8 0 0 0 38 18l-5 2-4-4 2-5z\" fill=\"#1f4e5f\"></path>\n          </svg>\n          <span id=\"open-status\">The workshop is open Tuesday to Saturday, 9:00 to 17:30.</span>\n        </p><!-- /wp:html --><!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">They had my commuter back the same afternoon, and it shifts better than it did new.</p><!-- /wp:paragraph --><cite>A rider from Larkbend (a made-up quote for this test)</cite></blockquote><!-- /wp:quote --></div><!-- /wp:group --></section><!-- /wp:group --></main><!-- /wp:group -->"
