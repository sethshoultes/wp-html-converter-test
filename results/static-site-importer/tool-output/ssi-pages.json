      "stored_content": "<!-- wp:group {\"tagName\":\"main\",\"metadata\":{\"name\":\"Main\"}} --><main class=\"wp-block-group\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"Services and prices\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Services and prices</h1><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Prices are fixed for labour. Parts are extra, and we tell you the part price before we fit anything. All prices are invented for this sample site.</p><!-- /wp:paragraph --><!-- wp:heading {\"anchor\":\"tune-ups\",\"level\":2} --><h2 id=\"tune-ups\" class=\"wp-block-heading\">Tune-up levels</h2><!-- /wp:heading --><!-- wp:table {\"hasFixedLayout\":false,\"className\":\"blocks-engine-table-a08582a5f056-0\"} --><figure class=\"wp-block-table blocks-engine-table-a08582a5f056-0\"><table><thead><tr><th>Service</th><th>What is included</th><th>Time</th><th>Price</th></tr></thead><tbody><tr><th>Safety check</th><td>Brakes, tyres, bolts, chain wear</td><td>20 min</td><td>15</td></tr><tr><th>Standard tune-up</th><td>Safety check, gears indexed, brakes adjusted, chain cleaned</td><td>1 hour</td><td>45</td></tr><tr><th>Full service</th><td>Standard tune-up, bearings serviced, wheels trued, cables replaced</td><td>Next morning</td><td>110</td></tr></tbody></table><figcaption class=\"wp-element-caption\">Labour prices, in made-up sample currency.</figcaption></figure><!-- /wp:table --></div><!-- /wp:group --></section><!-- /wp:group --><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"Wheels and cargo bikes\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"anchor\":\"wheels\",\"level\":2} --><h2 id=\"wheels\" class=\"wp-block-heading\">Wheels and cargo bikes</h2><!-- /wp:heading --><!-- wp:group {\"className\":\"cards blocks-engine-css-owned-layout blocks-engine-css-owned-grid\"} --><div class=\"wp-block-group cards blocks-engine-css-owned-layout blocks-engine-css-owned-grid\"><!-- wp:group {\"className\":\"card blocks-engine-css-owned-layout\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\",\"left\":\"var:preset|spacing|70\"}},\"border\":{\"width\":\"1px\",\"style\":\"solid\",\"color\":\"#e4ddd0\",\"radius\":\"var(\\u002d\\u002dqf-radius)\"}},\"tagName\":\"article\",\"metadata\":{\"name\":\"Wheel truing\"},\"backgroundColor\":\"accent-2\"} --><article class=\"wp-block-group has-border-color card blocks-engine-css-owned-layout has-background has-accent-2-background-color\" style=\"border-color:#e4ddd0;border-style:solid;border-width:1px;border-radius:var(--qf-radius);padding-top:var(--wp--preset--spacing--70);padding-right:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Wheel truing</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">A wobbly wheel trued on the stand, with spoke tension evened out.</p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Up to 3 spokes replaced</li><!-- /wp:list-item --><!-- wp:list-item --><li>Same-day for most wheels</li><!-- /wp:list-item --></ul><!-- /wp:list --></article><!-- /wp:group --><!-- wp:group {\"className\":\"card blocks-engine-css-owned-layout\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\",\"left\":\"var:preset|spacing|70\"}},\"border\":{\"width\":\"1px\",\"style\":\"solid\",\"color\":\"#e4ddd0\",\"radius\":\"var(\\u002d\\u002dqf-radius)\"}},\"tagName\":\"article\",\"metadata\":{\"name\":\"Hand-built wheels\"},\"backgroundColor\":\"accent-2\"} --><article class=\"wp-block-group has-border-color card blocks-engine-css-owned-layout has-background has-accent-2-background-color\" style=\"border-color:#e4ddd0;border-style:solid;border-width:1px;border-radius:var(--qf-radius);padding-top:var(--wp--preset--spacing--70);padding-right:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Hand-built wheels</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Built to your rims and hubs, tensioned and stress-relieved.</p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Ready in five working days</li><!-- /wp:list-item --><!-- wp:list-item --><li>Free re-true after a month</li><!-- /wp:list-item --></ul><!-- /wp:list --></article><!-- /wp:group --><!-- wp:group {\"anchor\":\"cargo\",\"className\":\"card blocks-engine-editor-anchor-cargo blocks-engine-css-owned-layout\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\",\"left\":\"var:preset|spacing|70\"}},\"border\":{\"width\":\"1px\",\"style\":\"solid\",\"color\":\"#e4ddd0\",\"radius\":\"var(\\u002d\\u002dqf-radius)\"}},\"tagName\":\"article\",\"metadata\":{\"name\":\"Cargo bike care\"},\"backgroundColor\":\"accent-2\"} --><article id=\"cargo\" class=\"wp-block-group has-border-color card blocks-engine-editor-anchor-cargo blocks-engine-css-owned-layout has-background has-accent-2-background-color\" style=\"border-color:#e4ddd0;border-style:solid;border-width:1px;border-radius:var(--qf-radius);padding-top:var(--wp--preset--spacing--70);padding-right:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Cargo bike care</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Longtails and front-loaders on our long stand, including steering and child-seat checks.</p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Booked slots only</li><!-- /wp:list-item --><!-- wp:list-item --><li>Collection by arrangement</li><!-- /wp:list-item --></ul><!-- /wp:list --></article><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --></section><!-- /wp:group --><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"Check your chain at home\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Check your chain at home</h2><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Between visits, a chain checker tells you when a chain is worn. Here is the rule we use, written as code:</p><!-- /wp:paragraph --><!-- wp:code {\"className\":\"language-js\"} --><pre class=\"wp-block-code language-js\"><code>// Chain wear, measured with a checker gauge.\nfunction chainAdvice(wearPercent) {\n  if (wearPercent &gt;= 0.75) {\n    return 'Replace the chain, and check the cassette.';\n  }\n  if (wearPercent &gt;= 0.5) {\n    return 'Replace the chain soon.';\n  }\n  return 'The chain is fine.';\n}</code></pre><!-- /wp:code --><!-- wp:list {\"ordered\":true} --><ol class=\"wp-block-list\"><!-- wp:list-item --><li>Shift to the smallest rear cog.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Drop the checker into the chain.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Read the gauge, then run the rule above.</li><!-- /wp:list-item --></ol><!-- /wp:list --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\"><a class=\"button\" href=\"/?page_id=15\">Book a service</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></section><!-- /wp:group --></main><!-- /wp:group -->"
