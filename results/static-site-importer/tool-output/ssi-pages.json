      "id": 14,
      "slug": "about",
      "title": "About",
      "url": "http://127.0.0.1:9400/about/",
      "stored_content": "<!-- wp:group {\"tagName\":\"main\",\"metadata\":{\"name\":\"Main\"}} --><main class=\"wp-block-group\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"About the workshop\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">About the workshop</h1><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Quillfern Cycle Works is two benches, one truing stand and a long wall of parts drawers. We fix the bikes people ride every day.</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">How a repair goes</h2><!-- /wp:heading --><!-- wp:list {\"ordered\":true} --><ol class=\"wp-block-list\"><!-- wp:list-item --><li>You bring the bike in, or book a slot on the <a href=\"/?page_id=15\">contact page</a>.</li><!-- /wp:list-item --><!-- wp:list-item --><li>We look it over with you and write down a price before any work starts.</li><!-- /wp:list-item --><!-- wp:list-item --><li>We do the work, test ride it, and text you when it is ready.</li><!-- /wp:list-item --><!-- wp:list-item --><li>You collect it and we show you what we changed.</li><!-- /wp:list-item --></ol><!-- /wp:list --><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What we believe</h2><!-- /wp:heading --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Fix before replace</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">A worn part gets replaced. A part that can be cleaned, adjusted or trued gets that instead.</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":4} --><h4 class=\"wp-block-heading\">What we will always tell you</h4><!-- /wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>What is worn, and how long it has left.</li><!-- /wp:list-item --><!-- wp:list-item --><li>What is safe to leave for now.</li><!-- /wp:list-item --><!-- wp:list-item --><li>What it costs, before we start.</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Every bike leaves road-tested</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">No bike goes back to its rider until one of us has ridden it round the block.</p><!-- /wp:paragraph --><!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">A bike that is looked after lasts for decades. Most of the work is small and regular.</p><!-- /wp:paragraph --><cite>The workshop&#039;s house rule</cite></blockquote><!-- /wp:quote --></div><!-- /wp:group --></section><!-- /wp:group --><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"From the bench\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">From the bench</h2><!-- /wp:heading --><!-- wp:group {\"className\":\"gallery blocks-engine-css-owned-layout blocks-engine-css-owned-flow\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"0\",\"bottom\":\"0\",\"left\":\"0\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group gallery blocks-engine-css-owned-layout blocks-engine-css-owned-flow\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><!-- wp:image {\"className\":\"is-resized be-inline-geometry-2e7af10f3e498df1 blocks-engine-source-figure-fe0222852181-0\",\"width\":\"100%\",\"id\":6} --><figure class=\"wp-block-image is-resized be-inline-geometry-2e7af10f3e498df1 blocks-engine-source-figure-fe0222852181-0\"><img class=\"wp-image-6\" src=\"http://127.0.0.1:9400/wp-content/uploads/2026/10/gallery-roadster.svg\" alt=\"Drawing of a roadster bicycle\" style=\"width:100%\"/><figcaption class=\"wp-element-caption\">A roadster rebuild: new bearings and a fresh chain.</figcaption></figure><!-- /wp:image --><!-- wp:image {\"className\":\"is-resized be-inline-geometry-bac184d75f118f38 blocks-engine-source-figure-fe0222852181-0\",\"width\":\"100%\",\"id\":7} --><figure class=\"wp-block-image is-resized be-inline-geometry-bac184d75f118f38 blocks-engine-source-figure-fe0222852181-0\"><img class=\"wp-image-7\" src=\"http://127.0.0.1:9400/wp-content/uploads/2026/10/gallery-commuter.svg\" alt=\"Drawing of a commuter bicycle\" style=\"width:100%\"/><figcaption class=\"wp-element-caption\">A commuter tune-up, back the same afternoon.</figcaption></figure><!-- /wp:image --><!-- wp:image {\"className\":\"is-resized be-inline-geometry-5105208061b55fd1 blocks-engine-source-figure-fe0222852181-0\",\"width\":\"100%\",\"id\":10} --><figure class=\"wp-block-image is-resized be-inline-geometry-5105208061b55fd1 blocks-engine-source-figure-fe0222852181-0\"><img class=\"wp-image-10\" src=\"http://127.0.0.1:9400/wp-content/uploads/2026/10/gallery-cargo.svg\" alt=\"Drawing of a cargo bicycle\" style=\"width:100%\"/><figcaption class=\"wp-element-caption\">Cargo bike service, on the long stand.</figcaption></figure><!-- /wp:image --><!-- wp:image {\"className\":\"is-resized be-inline-geometry-e06f3645342e4189 blocks-engine-source-figure-fe0222852181-0\",\"width\":\"100%\",\"id\":9} --><figure class=\"wp-block-image is-resized be-inline-geometry-e06f3645342e4189 blocks-engine-source-figure-fe0222852181-0\"><img class=\"wp-image-9\" src=\"http://127.0.0.1:9400/wp-content/uploads/2026/10/gallery-wheels.svg\" alt=\"Drawing of a bicycle on a truing stand\" style=\"width:100%\"/><figcaption class=\"wp-element-caption\">Wheel truing, to half a millimetre.</figcaption></figure><!-- /wp:image --></div><!-- /wp:group --></div><!-- /wp:group --></section><!-- /wp:group --><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"A short film we like\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">A short film we like</h2><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Big Buck Bunny, an open film from the Blender Foundation (CC BY 3.0). It has nothing to do with bikes, but it is free to share.</p><!-- /wp:paragraph --><!-- wp:group {\"className\":\"embed\"} --><div class=\"wp-block-group embed\"><!-- wp:embed {\"url\":\"https://www.youtube.com/watch?v=aqz-KE-bpKQ\",\"type\":\"video\",\"providerNameSlug\":\"youtube\"} -->\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube\"><div class=\"wp-block-embed__wrapper\">\nhttps://www.youtube.com/watch?v=aqz-KE-bpKQ\n</div></figure>\n<!-- /wp:embed --></div><!-- /wp:group --></div><!-- /wp:group --></section><!-- /wp:group --></main><!-- /wp:group -->"
