-node-dd16bc117b40 ssi-textarea-rows-5\",\"type\":\"textarea\"} /--></div>\n<!-- /wp:jetpack/field-textarea --></div><!-- /wp:ssi-quillfern-cycle-works/layout-shell --><!-- wp:ssi-quillfern-cycle-works/layout-shell {\"wrappers\":[{\"tagName\":\"div\",\"attributes\":[]}]} --><div><!-- wp:ssi-quillfern-cycle-works/layout-shell {\"wrappers\":[{\"tagName\":\"div\",\"attributes\":{\"class\":\"blocks-engine-source-label-fabd71be4ec2-0\"}}],\"className\":\"blocks-engine-source-label-fabd71be4ec2-0\"} --><div class=\"blocks-engine-source-label-fabd71be4ec2-0\"><!-- wp:jetpack/field-checkbox {\"shareFieldAttributes\":false,\"className\":\"ssi-node-98f5e26075e6\"} -->\n<div><!-- wp:jetpack/option {\"label\":\"Text me when it is ready\",\"isStandalone\":true,\"className\":\"ssi-node-ca62fd184694 ssi-source-choice-label\\u002d\\u002dssi-node-02f71ed207a8\"} /--></div>\n<!-- /wp:jetpack/field-checkbox --></div><!-- /wp:ssi-quillfern-cycle-works/layout-shell --></div><!-- /wp:ssi-quillfern-cycle-works/layout-shell --><!-- wp:button {\"tagName\":\"button\",\"type\":\"submit\",\"lock\":{\"remove\":true},\"className\":\"form-button-submit is-submit ssi-source-submit\\u002d\\u002dbutton ssi-provider-submit-presentation ssi-node-e26ad1988787 ssi-node-3122ba8d38af button\",\"metadata\":{\"name\":\"Submit button\"}} -->\n<div class=\"wp-block-button form-button-submit is-submit ssi-source-submit--button ssi-provider-submit-presentation ssi-node-e26ad1988787 ssi-node-3122ba8d38af button\"><button type=\"submit\" class=\"wp-block-button__link wp-element-button\">Send booking request</button></div>\n<!-- /wp:button --><!-- wp:paragraph {\"anchor\":\"form-status\",\"className\":\"status blocks-engine-source-p-2dd0f2ccde1c-0\",\"style\":{\"typography\":{\"fontStyle\":\"italic\"},\"color\":{\"text\":\"var(\\u002d\\u002dqf-muted)\"}}} --><p id=\"form-status\" class=\"has-text-color status blocks-engine-source-p-2dd0f2ccde1c-0\" style=\"color:var(--qf-muted);font-style:italic\">This sample form does not send anything.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div>\n<!-- /wp:jetpack/contact-form --></div><!-- /wp:group --></section><!-- /wp:group --><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"Find the workshop\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Find the workshop</h2><!-- /wp:heading --><!-- wp:html --><svg class=\"map\" width=\"320\" height=\"200\" viewBox=\"0 0 320 200\" role=\"img\" aria-labelledby=\"map-title\">\n          \n          <rect width=\"320\" height=\"200\" fill=\"#e3efe9\"></rect>\n          <rect x=\"0\" y=\"90\" width=\"320\" height=\"22\" fill=\"#ffffff\"></rect>\n          <rect x=\"150\" y=\"0\" width=\"20\" height=\"200\" fill=\"#ffffff\"></rect>\n          <rect x=\"190\" y=\"125\" width=\"110\" height=\"60\" fill=\"#b8d8c4\"></rect>\n          <circle cx=\"120\" cy=\"80\" r=\"10\" fill=\"#8a3b12\"></circle>\n          <text x=\"10\" y=\"106\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#1a2624\">Ferrule Lane</text>\n          <text x=\"205\" y=\"160\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#1a2624\">Larkbend Park</text>\n        </svg><!-- /wp:html --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Opening hours</h3><!-- /wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Tuesday to Friday: 9:00 to 17:30</li><!-- /wp:list-item --><!-- wp:list-item --><li>Saturday: 9:00 to 16:00</li><!-- /wp:list-item --><!-- wp:list-item --><li>Sunday and Monday: closed</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Phone: <a href=\"tel:+15555550142\">555-0142</a> (a fictional number). Email: <a href=\"mailto:hello@quillfern.example\">hello@quillfern.example</a></p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\"><a class=\"button\" href=\"/?page_id=16\">See services and prices</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></section><!-- /wp:group --></main><!-- /wp:group -->"
