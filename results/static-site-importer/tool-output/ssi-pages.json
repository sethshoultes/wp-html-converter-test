      "stored_content": "<!-- wp:group {\"tagName\":\"main\",\"metadata\":{\"name\":\"Main\"}} --><main class=\"wp-block-group\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|110\",\"right\":\"0\",\"bottom\":\"var:preset|spacing|110\",\"left\":\"0\"}}},\"tagName\":\"section\",\"metadata\":{\"name\":\"Book a repair\"}} --><section class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--110);padding-right:0;padding-bottom:var(--wp--preset--spacing--110);padding-left:0\"><!-- wp:group {\"className\":\"wrap\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"var:preset|spacing|70\",\"bottom\":\"0\",\"left\":\"var:preset|spacing|70\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} --><div class=\"wp-block-group wrap\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-right:var(--wp--preset--spacing--70);padding-bottom:0;padding-left:var(--wp--preset--spacing--70)\"><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Book a repair</h1><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"blocks-engine-source-p-2dd0f2ccde1c-0\"} --><p class=\"blocks-engine-source-p-2dd0f2ccde1c-0\">Tell us about the bike and when you can bring it in. We reply within one working day.</p><!-- /wp:paragraph --><!-- wp:jetpack/contact-form {\"className\":\"ssi-form-ce94a53831f5\"} -->\n<div class=\"wp-block-jetpack-contact-form ssi-form-ce94a53831f5\"><!-- wp:group {\"anchor\":\"booking\",\"className\":\"blocks-engine-css-owned-layout blocks-engine-css-owned-grid blocks-engine-source-form-3c9349c8b7f5-0\"} --><div id=\"booking\" class=\"wp-block-group blocks-engine-css-owned-layout blocks-engine-css-owned-grid blocks-engine-source-form-3c9349c8b7f5-0\"><!-- wp:ssi-quillfern-cycle-works/layout-shell {\"wrappers\":[{\"tagName\":\"div\",\"attributes\":[]}]} --><div><!-- wp:jetpack/field-text {\"required\":true,\"requiredIndicator\":false,\"shareFieldAttributes\":false,\"className\":\"ssi-node-e5fa583cd021\"} -->