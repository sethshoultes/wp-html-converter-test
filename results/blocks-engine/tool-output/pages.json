        "stored_content": "<!-- wp:group {\"className\":\"site-header\",\"tagName\":\"header\",\"metadata\":{\"name\":\"Header\"}} --><header class=\"wp-block-group site-header\"><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:buttons {\"className\":\"blocks-engine-layout-neutral-buttons\"} --><div class=\"wp-block-buttons blocks-engine-layout-neutral-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"transparent\"},\"border\":{\"radius\":\"0\"},\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"0\",\"bottom\":\"0\",\"left\":\"0\"}}},\"className\":\"blocks-engine-layout-child-button blocks-engine-native-button-alignment-start\"} --><div class=\"wp-block-button blocks-engine-layout-child-button blocks-engine-native-button-alignment-start\"><a class=\"wp-block-button__link has-background wp-element-button\" style=\"border-radius:0;background-color:transparent;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\"><img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/logo.svg\" alt=\"\" width=\"40\" height=\"40\">\n        Quillfern Cycle Works<\/a><\/div><!-- \/wp:button --><\/div><!-- \/wp:buttons --><!-- wp:navigation {\"anchor\":\"site-nav\",\"className\":\"site-nav blocks-engine-list-navigation blocks-engine-native-responsive-navigation blocks-engine-native-navigation-toggle-b5e9ccdeeabe\",\"style\":{\"spacing\":{\"blockGap\":\"0px\"}},\"overlayMenu\":\"mobile\"} --><!-- wp:navigation-link {\"label\":\"Home\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"label\":\"About\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"className\":\"blocks-engine-current-navigation-item\",\"label\":\"Services\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"label\":\"Contact\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\",\"kind\":\"custom\"} \/--><!-- \/wp:navigation --><\/div><!-- \/wp:group --><\/header><!-- \/wp:group --><!-- wp:group {\"tagName\":\"main\",\"metadata\":{\"name\":\"Main\"}} --><main class=\"wp-block-group\"><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Services and prices<\/h1><!-- \/wp:heading --><!-- wp:paragraph --><p>Prices are fixed for labour. Parts are extra, and we tell you the part price before we fit anything. All prices are invented for this sample site.<\/p><!-- \/wp:paragraph --><!-- wp:heading {\"anchor\":\"tune-ups\",\"level\":2} --><h2 id=\"tune-ups\" class=\"wp-block-heading\">Tune-up levels<\/h2><!-- \/wp:heading --><!-- wp:table {\"hasFixedLayout\":false,\"className\":\"blocks-engine-table-6442b2a2d5ba-0\"} --><figure class=\"wp-block-table blocks-engine-table-6442b2a2d5ba-0\"><table><thead><tr><th>Service<\/th><th>What is included<\/th><th>Time<\/th><th>Price<\/th><\/tr><\/thead><tbody><tr><th>Safety check<\/th><td>Brakes, tyres, bolts, chain wear<\/td><td>20 min<\/td><td>15<\/td><\/tr><tr><th>Standard tune-up<\/th><td>Safety check, gears indexed, brakes adjusted, chain cleaned<\/td><td>1 hour<\/td><td>45<\/td><\/tr><tr><th>Full service<\/th><td>Standard tune-up, bearings serviced, wheels trued, cables replaced<\/td><td>Next morning<\/td><td>110<\/td><\/tr><\/tbody><\/table><figcaption class=\"wp-element-caption\">Labour prices, in made-up sample currency.<\/figcaption><\/figure><!-- \/wp:table --><\/div><!-- \/wp:group --><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"anchor\":\"wheels\",\"level\":2} --><h2 id=\"wheels\" class=\"wp-block-heading\">Wheels and cargo bikes<\/h2><!-- \/wp:heading --><!-- wp:group {\"className\":\"cards\",\"layout\":{\"type\":\"grid\"}} --><div class=\"wp-block-group is-layout-grid wp-block-group-is-layout-grid cards\"><!-- wp:group {\"className\":\"card\",\"tagName\":\"article\",\"metadata\":{\"name\":\"Wheel truing\"}} --><article class=\"wp-block-group card\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Wheel truing<\/h3><!-- \/wp:heading --><!-- wp:paragraph --><p>A wobbly wheel trued on the stand, with spoke tension evened out.<\/p><!-- \/wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Up to 3 spokes replaced<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Same-day for most wheels<\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><\/article><!-- \/wp:group --><!-- wp:group {\"className\":\"card\",\"tagName\":\"article\",\"metadata\":{\"name\":\"Hand-built wheels\"}} --><article class=\"wp-block-group card\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Hand-built wheels<\/h3><!-- \/wp:heading --><!-- wp:paragraph --><p>Built to your rims and hubs, tensioned and stress-relieved.<\/p><!-- \/wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Ready in five working days<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Free re-true after a month<\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><\/article><!-- \/wp:group --><!-- wp:group {\"anchor\":\"cargo\",\"className\":\"card blocks-engine-editor-anchor-cargo\",\"tagName\":\"article\",\"metadata\":{\"name\":\"Cargo bike care\"}} --><article id=\"cargo\" class=\"wp-block-group card blocks-engine-editor-anchor-cargo\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Cargo bike care<\/h3><!-- \/wp:heading --><!-- wp:paragraph --><p>Longtails and front-loaders on our long stand, including steering and child-seat checks.<\/p><!-- \/wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Booked slots only<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Collection by arrangement<\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><\/article><!-- \/wp:group --><\/div><!-- \/wp:group --><\/div><!-- \/wp:group --><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Check your chain at home<\/h2><!-- \/wp:heading --><!-- wp:paragraph --><p>Between visits, a chain checker tells you when a chain is worn. Here is the rule we use, written as code:<\/p><!-- \/wp:paragraph --><!-- wp:code {\"className\":\"language-js\"} --><pre class=\"wp-block-code language-js\"><code>\/\/ Chain wear, measured with a checker gauge.\nfunction chainAdvice(wearPercent) {\n  if (wearPercent &gt;= 0.75) {\n    return 'Replace the chain, and check the cassette.';\n  }\n  if (wearPercent &gt;= 0.5) {\n    return 'Replace the chain soon.';\n  }\n  return 'The chain is fine.';\n}<\/code><\/pre><!-- \/wp:code --><!-- wp:list {\"ordered\":true} --><ol class=\"wp-block-list\"><!-- wp:list-item --><li>Shift to the smallest rear cog.<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Drop the checker into the chain.<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Read the gauge, then run the rule above.<\/li><!-- \/wp:list-item --><\/ol><!-- \/wp:list --><!-- wp:paragraph --><p><a class=\"button\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Book a service<\/a><\/p><!-- \/wp:paragraph --><\/div><!-- \/wp:group --><\/main><!-- \/wp:group --><!-- wp:group {\"className\":\"site-footer\",\"tagName\":\"footer\",\"metadata\":{\"name\":\"Footer\"}} --><footer class=\"wp-block-group site-footer\"><!-- wp:group {\"className\":\"wrap footer-cols\"} --><div class=\"wp-block-group wrap footer-cols\"><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Quillfern Cycle Works<\/h2><!-- \/wp:heading --><!-- wp:paragraph --><p>14 Ferrule Lane, Larkbend<\/p><!-- \/wp:paragraph --><\/div><!-- \/wp:group --><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Pages<\/h2><!-- \/wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\">About<\/a><\/li><!-- \/wp:list-item --><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\">Services<\/a><\/li><!-- \/wp:list-item --><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Contact<\/a><\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><\/div><!-- \/wp:group --><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:paragraph --><p>Quillfern Cycle Works is a fictional business, made for a software test.<\/p><!-- \/wp:paragraph --><!-- wp:paragraph --><p>\u00a9 <mark class=\"year\" style=\"background-color:transparent;color:inherit\" role=\"none\">2026<\/mark> Sample site, MIT licence.<\/p><!-- \/wp:paragraph --><\/div><!-- \/wp:group --><\/div><!-- \/wp:group --><\/footer><!-- \/wp:group -->"
    },
