        "stored_content": "<!-- wp:group {\"className\":\"site-header\",\"tagName\":\"header\",\"metadata\":{\"name\":\"Header\"}} --><header class=\"wp-block-group site-header\"><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:buttons {\"className\":\"blocks-engine-layout-neutral-buttons\"} --><div class=\"wp-block-buttons blocks-engine-layout-neutral-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"transparent\"},\"border\":{\"radius\":\"0\"},\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"0\",\"bottom\":\"0\",\"left\":\"0\"}}},\"className\":\"blocks-engine-layout-child-button blocks-engine-native-button-alignment-start\"} --><div class=\"wp-block-button blocks-engine-layout-child-button blocks-engine-native-button-alignment-start\"><a class=\"wp-block-button__link has-background wp-element-button\" style=\"border-radius:0;background-color:transparent;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\"><img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/logo.svg\" alt=\"\" width=\"40\" height=\"40\">\n        Quillfern Cycle Works<\/a><\/div><!-- \/wp:button --><\/div><!-- \/wp:buttons --><!-- wp:navigation {\"anchor\":\"site-nav\",\"className\":\"site-nav blocks-engine-list-navigation blocks-engine-native-responsive-navigation blocks-engine-native-navigation-toggle-b5e9ccdeeabe\",\"style\":{\"spacing\":{\"blockGap\":\"0px\"}},\"overlayMenu\":\"mobile\"} --><!-- wp:navigation-link {\"label\":\"Home\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"className\":\"blocks-engine-current-navigation-item\",\"label\":\"About\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"label\":\"Services\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"label\":\"Contact\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\",\"kind\":\"custom\"} \/--><!-- \/wp:navigation --><\/div><!-- \/wp:group --><\/header><!-- \/wp:group --><!-- wp:group {\"tagName\":\"main\",\"metadata\":{\"name\":\"Main\"}} --><main class=\"wp-block-group\"><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">About the workshop<\/h1><!-- \/wp:heading --><!-- wp:paragraph --><p>Quillfern Cycle Works is two benches, one truing stand and a long wall of parts drawers. We fix the bikes people ride every day.<\/p><!-- \/wp:paragraph --><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">How a repair goes<\/h2><!-- \/wp:heading --><!-- wp:list {\"ordered\":true} --><ol class=\"wp-block-list\"><!-- wp:list-item --><li>You bring the bike in, or book a slot on the <a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">contact page<\/a>.<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>We look it over with you and write down a price before any work starts.<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>We do the work, test ride it, and text you when it is ready.<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>You collect it and we show you what we changed.<\/li><!-- \/wp:list-item --><\/ol><!-- \/wp:list --><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What we believe<\/h2><!-- \/wp:heading --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Fix before replace<\/h3><!-- \/wp:heading --><!-- wp:paragraph --><p>A worn part gets replaced. A part that can be cleaned, adjusted or trued gets that instead.<\/p><!-- \/wp:paragraph --><!-- wp:heading {\"level\":4} --><h4 class=\"wp-block-heading\">What we will always tell you<\/h4><!-- \/wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>What is worn, and how long it has left.<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>What is safe to leave for now.<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>What it costs, before we start.<\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Every bike leaves road-tested<\/h3><!-- \/wp:heading --><!-- wp:paragraph --><p>No bike goes back to its rider until one of us has ridden it round the block.<\/p><!-- \/wp:paragraph --><!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>A bike that is looked after lasts for decades. Most of the work is small and regular.<\/p><!-- \/wp:paragraph --><cite>The workshop&#039;s house rule<\/cite><\/blockquote><!-- \/wp:quote --><\/div><!-- \/wp:group --><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">From the bench<\/h2><!-- \/wp:heading --><!-- wp:gallery {\"className\":\"gallery\"} --><figure class=\"wp-block-gallery has-nested-images columns-default is-cropped gallery\"><!-- wp:image {\"className\":\"is-resized\",\"width\":\"600px\",\"height\":\"400px\"} --><figure class=\"wp-block-image is-resized\"><img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/gallery-roadster.svg\" alt=\"Drawing of a roadster bicycle\" style=\"width:600px;height:400px\"\/><figcaption class=\"wp-element-caption\">A roadster rebuild: new bearings and a fresh chain.<\/figcaption><\/figure><!-- \/wp:image --><!-- wp:image {\"className\":\"is-resized\",\"width\":\"600px\",\"height\":\"400px\"} --><figure class=\"wp-block-image is-resized\"><img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/gallery-commuter.svg\" alt=\"Drawing of a commuter bicycle\" style=\"width:600px;height:400px\"\/><figcaption class=\"wp-element-caption\">A commuter tune-up, back the same afternoon.<\/figcaption><\/figure><!-- \/wp:image --><!-- wp:image {\"className\":\"is-resized\",\"width\":\"600px\",\"height\":\"400px\"} --><figure class=\"wp-block-image is-resized\"><img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/gallery-cargo.svg\" alt=\"Drawing of a cargo bicycle\" style=\"width:600px;height:400px\"\/><figcaption class=\"wp-element-caption\">Cargo bike service, on the long stand.<\/figcaption><\/figure><!-- \/wp:image --><!-- wp:image {\"className\":\"is-resized\",\"width\":\"600px\",\"height\":\"400px\"} --><figure class=\"wp-block-image is-resized\"><img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/gallery-wheels.svg\" alt=\"Drawing of a bicycle on a truing stand\" style=\"width:600px;height:400px\"\/><figcaption class=\"wp-element-caption\">Wheel truing, to half a millimetre.<\/figcaption><\/figure><!-- \/wp:image --><\/figure><!-- \/wp:gallery --><\/div><!-- \/wp:group --><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">A short film we like<\/h2><!-- \/wp:heading --><!-- wp:paragraph --><p>Big Buck Bunny, an open film from the Blender Foundation (CC BY 3.0). It has nothing to do with bikes, but it is free to share.<\/p><!-- \/wp:paragraph --><!-- wp:group {\"className\":\"embed\"} --><div class=\"wp-block-group embed\"><!-- wp:embed {\"url\":\"https:\/\/www.youtube.com\/watch?v=aqz-KE-bpKQ\",\"type\":\"video\",\"providerNameSlug\":\"youtube\"} -->\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube\"><div class=\"wp-block-embed__wrapper\">\nhttps:\/\/www.youtube.com\/watch?v=aqz-KE-bpKQ\n<\/div><\/figure>\n<!-- \/wp:embed --><\/div><!-- \/wp:group --><\/div><!-- \/wp:group --><\/main><!-- \/wp:group --><!-- wp:group {\"className\":\"site-footer\",\"tagName\":\"footer\",\"metadata\":{\"name\":\"Footer\"}} --><footer class=\"wp-block-group site-footer\"><!-- wp:group {\"className\":\"wrap footer-cols\"} --><div class=\"wp-block-group wrap footer-cols\"><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Quillfern Cycle Works<\/h2><!-- \/wp:heading --><!-- wp:paragraph --><p>14 Ferrule Lane, Larkbend<\/p><!-- \/wp:paragraph --><\/div><!-- \/wp:group --><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Pages<\/h2><!-- \/wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\">About<\/a><\/li><!-- \/wp:list-item --><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\">Services<\/a><\/li><!-- \/wp:list-item --><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Contact<\/a><\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><\/div><!-- \/wp:group --><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:paragraph --><p>Quillfern Cycle Works is a fictional business, made for a software test.<\/p><!-- \/wp:paragraph --><!-- wp:paragraph --><p>\u00a9 <mark class=\"year\" style=\"background-color:transparent;color:inherit\" role=\"none\">2026<\/mark> Sample site, MIT licence.<\/p><!-- \/wp:paragraph --><\/div><!-- \/wp:group --><\/div><!-- \/wp:group --><\/footer><!-- \/wp:group -->"
