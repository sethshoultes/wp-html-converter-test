        "stored_content": "<!-- wp:group {\"className\":\"site-header\",\"tagName\":\"header\",\"metadata\":{\"name\":\"Header\"}} --><header class=\"wp-block-group site-header\"><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:buttons {\"className\":\"blocks-engine-layout-neutral-buttons\"} --><div class=\"wp-block-buttons blocks-engine-layout-neutral-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"transparent\"},\"border\":{\"radius\":\"0\"},\"spacing\":{\"padding\":{\"top\":\"0\",\"right\":\"0\",\"bottom\":\"0\",\"left\":\"0\"}}},\"className\":\"blocks-engine-layout-child-button blocks-engine-native-button-alignment-start\"} --><div class=\"wp-block-button blocks-engine-layout-child-button blocks-engine-native-button-alignment-start\"><a class=\"wp-block-button__link has-background wp-element-button\" style=\"border-radius:0;background-color:transparent;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\"><img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/logo.svg\" alt=\"\" width=\"40\" height=\"40\">\n        Quillfern Cycle Works<\/a><\/div><!-- \/wp:button --><\/div><!-- \/wp:buttons --><!-- wp:navigation {\"anchor\":\"site-nav\",\"className\":\"site-nav blocks-engine-list-navigation blocks-engine-native-responsive-navigation blocks-engine-native-navigation-toggle-b5e9ccdeeabe\",\"style\":{\"spacing\":{\"blockGap\":\"0px\"}},\"overlayMenu\":\"mobile\"} --><!-- wp:navigation-link {\"label\":\"Home\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"label\":\"About\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"label\":\"Services\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\",\"kind\":\"custom\"} \/--><!-- wp:navigation-link {\"className\":\"blocks-engine-current-navigation-item\",\"label\":\"Contact\",\"url\":\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\",\"kind\":\"custom\"} \/--><!-- \/wp:navigation --><\/div><!-- \/wp:group --><\/header><!-- \/wp:group --><!-- wp:group {\"tagName\":\"main\",\"metadata\":{\"name\":\"Main\"}} --><main class=\"wp-block-group\"><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Book a repair<\/h1><!-- \/wp:heading --><!-- wp:paragraph --><p>Tell us about the bike and when you can bring it in. We reply within one working day.<\/p><!-- \/wp:paragraph --><!-- wp:group {\"anchor\":\"booking\",\"tagName\":\"form\"} --><form id=\"booking\" class=\"wp-block-group\"><!-- wp:paragraph {\"anchor\":\"name\",\"className\":\"blocks-engine-synthetic-paragraph\"} --><p id=\"name\" class=\"blocks-engine-synthetic-paragraph\">Your name (required)<\/p><!-- \/wp:paragraph --><!-- wp:paragraph {\"anchor\":\"email\",\"className\":\"blocks-engine-synthetic-paragraph\"} --><p id=\"email\" class=\"blocks-engine-synthetic-paragraph\">Email (required)<\/p><!-- \/wp:paragraph --><!-- wp:group {\"anchor\":\"service\"} --><div id=\"service\" class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"blocks-engine-synthetic-paragraph\"} --><p class=\"blocks-engine-synthetic-paragraph\">Service<\/p><!-- \/wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Safety check<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Standard tune-up (selected)<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Full service<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Wheel work<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Cargo bike care<\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><\/div><!-- \/wp:group --><!-- wp:paragraph {\"anchor\":\"message\",\"className\":\"blocks-engine-synthetic-paragraph\"} --><p id=\"message\" class=\"blocks-engine-synthetic-paragraph\">About the bike<\/p><!-- \/wp:paragraph --><!-- wp:paragraph {\"className\":\"blocks-engine-synthetic-paragraph\"} --><p class=\"blocks-engine-synthetic-paragraph\">Text me when it is ready: yes<\/p><!-- \/wp:paragraph --><!-- wp:custom\/authored-button {\"type\":\"submit\",\"className\":\"button\",\"text\":\"Send booking request\"} --><button type=\"submit\" class=\"button\">Send booking request<\/button><!-- \/wp:custom\/authored-button --><!-- wp:paragraph {\"anchor\":\"form-status\",\"className\":\"status\"} --><p id=\"form-status\" class=\"status\">This sample form does not send anything.<\/p><!-- \/wp:paragraph --><\/form><!-- \/wp:group --><\/div><!-- \/wp:group --><!-- wp:group {\"className\":\"wrap\"} --><div class=\"wp-block-group wrap\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Find the workshop<\/h2><!-- \/wp:heading --><!-- wp:html --><svg class=\"map\" width=\"320\" height=\"200\" viewBox=\"0 0 320 200\" role=\"img\" aria-labelledby=\"map-title\">\n          \n          <rect width=\"320\" height=\"200\" fill=\"#e3efe9\"><\/rect>\n          <rect x=\"0\" y=\"90\" width=\"320\" height=\"22\" fill=\"#ffffff\"><\/rect>\n          <rect x=\"150\" y=\"0\" width=\"20\" height=\"200\" fill=\"#ffffff\"><\/rect>\n          <rect x=\"190\" y=\"125\" width=\"110\" height=\"60\" fill=\"#b8d8c4\"><\/rect>\n          <circle cx=\"120\" cy=\"80\" r=\"10\" fill=\"#8a3b12\"><\/circle>\n          <text x=\"10\" y=\"106\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#1a2624\">Ferrule Lane<\/text>\n          <text x=\"205\" y=\"160\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#1a2624\">Larkbend Park<\/text>\n        <\/svg><!-- \/wp:html --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Opening hours<\/h3><!-- \/wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Tuesday to Friday: 9:00 to 17:30<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Saturday: 9:00 to 16:00<\/li><!-- \/wp:list-item --><!-- wp:list-item --><li>Sunday and Monday: closed<\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><!-- wp:paragraph --><p>Phone: <a href=\"tel:+15555550142\">555-0142<\/a> (a fictional number). Email: <a href=\"mailto:hello@quillfern.example\">hello@quillfern.example<\/a><\/p><!-- \/wp:paragraph --><!-- wp:paragraph --><p><a class=\"button\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\">See services and prices<\/a><\/p><!-- \/wp:paragraph --><\/div><!-- \/wp:group --><\/main><!-- \/wp:group --><!-- wp:group {\"className\":\"site-footer\",\"tagName\":\"footer\",\"metadata\":{\"name\":\"Footer\"}} --><footer class=\"wp-block-group site-footer\"><!-- wp:group {\"className\":\"wrap footer-cols\"} --><div class=\"wp-block-group wrap footer-cols\"><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Quillfern Cycle Works<\/h2><!-- \/wp:heading --><!-- wp:paragraph --><p>14 Ferrule Lane, Larkbend<\/p><!-- \/wp:paragraph --><\/div><!-- \/wp:group --><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Pages<\/h2><!-- \/wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\">About<\/a><\/li><!-- \/wp:list-item --><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\">Services<\/a><\/li><!-- \/wp:list-item --><!-- wp:list-item --><li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Contact<\/a><\/li><!-- \/wp:list-item --><\/ul><!-- \/wp:list --><\/div><!-- \/wp:group --><!-- wp:group --><div class=\"wp-block-group\"><!-- wp:paragraph --><p>Quillfern Cycle Works is a fictional business, made for a software test.<\/p><!-- \/wp:paragraph --><!-- wp:paragraph --><p>\u00a9 <mark class=\"year\" style=\"background-color:transparent;color:inherit\" role=\"none\">2026<\/mark> Sample site, MIT licence.<\/p><!-- \/wp:paragraph --><\/div><!-- 