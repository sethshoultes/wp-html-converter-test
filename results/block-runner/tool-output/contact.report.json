  "output": "<!-- wp:group {\"tagName\":\"header\"} -->\n<header class=\"wp-block-group\"><!-- wp:html -->\n<a class=\"brand\" href=\"http://127.0.0.1:9400/sample-site/index.html\">\n        <img src=\"http://127.0.0.1:9400/sample-site/assets/img/logo.svg\" alt=\"\" width=\"40\" height=\"40\">\n        Quillfern Cycle Works\n      </a>\n<!-- /wp:html -->\n\n<!-- wp:html -->\n<button class=\"nav-toggle\" type=\"button\" aria-controls=\"site-nav\" aria-expanded=\"false\">Menu</button>\n<!-- /wp:html -->\n\n<!-- wp:html -->\n<nav class=\"site-nav\" id=\"site-nav\" aria-label=\"Main\">\n        <ul>\n          <li><a href=\"http://127.0.0.1:9400/sample-site/index.html\">Home</a></li>\n          <li><a href=\"http://127.0.0.1:9400/sample-site/about.html\">About</a></li>\n          <li><a href=\"http://127.0.0.1:9400/sample-site/services.html\">Services</a></li>\n          <li><a href=\"http://127.0.0.1:9400/sample-site/contact.html\" aria-current=\"page\">Contact</a></li>\n        </ul>\n      </nav>\n<!-- /wp:html --></header>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"main\"} -->\n<main class=\"wp-block-group\"><!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Book a repair</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Tell us about the bike and when you can bring it in. We reply within one working day.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<form id=\"booking\" action=\"#\" method=\"post\">\n          <div>\n            <label for=\"name\">Your name</label>\n            <input id=\"name\" name=\"name\" type=\"text\" autocomplete=\"name\" required=\"\">\n          </div>\n          <div>\n            <label for=\"email\">Email</label>\n            <input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\" required=\"\">\n          </div>\n          <div>\n            <label for=\"service\">Service</label>\n            <select id=\"service\" name=\"service\">\n              <option value=\"safety\">Safety check</option>\n              <option value=\"standard\" selected=\"\">Standard tune-up</option>\n              <option value=\"full\">Full service</option>\n              <option value=\"wheels\">Wheel work</option>\n              <option value=\"cargo\">Cargo bike care</option>\n            </select>\n          </div>\n          <div>\n            <label for=\"message\">About the bike</label>\n            <textarea id=\"message\" name=\"message\" rows=\"5\"></textarea>\n          </div>\n          <div>\n            <label><input type=\"checkbox\" name=\"text-me\" value=\"yes\"> Text me when it is ready</label>\n          </div>\n          <button class=\"button\" type=\"submit\">Send booking request</button>\n          <p class=\"status\" id=\"form-status\" aria-live=\"polite\">This sample form does not send anything.</p>\n        </form>\n<!-- /wp:html --></section>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Find the workshop</h2>\n<!-- /wp:heading -->\n\n<!-- wp:html -->\n<svg class=\"map\" width=\"320\" height=\"200\" viewBox=\"0 0 320 200\" role=\"img\" aria-labelledby=\"map-title\">\n          <title id=\"map-title\">Map showing the workshop on Ferrule Lane, next to the park</title>\n          <rect width=\"320\" height=\"200\" fill=\"#e3efe9\"></rect>\n          <rect x=\"0\" y=\"90\" width=\"320\" height=\"22\" fill=\"#ffffff\"></rect>\n          <rect x=\"150\" y=\"0\" width=\"20\" height=\"200\" fill=\"#ffffff\"></rect>\n          <rect x=\"190\" y=\"125\" width=\"110\" height=\"60\" fill=\"#b8d8c4\"></rect>\n          <circle cx=\"120\" cy=\"80\" r=\"10\" fill=\"#8a3b12\"></circle>\n          <text x=\"10\" y=\"106\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#1a2624\">Ferrule Lane</text>\n          <text x=\"205\" y=\"160\" font-family=\"sans-serif\" font-size=\"12\" fill=\"#1a2624\">Larkbend Park</text>\n        </svg>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Opening hours</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Tuesday to Friday: 9:00 to 17:30</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Saturday: 9:00 to 16:00</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Sunday and Monday: closed</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"tel:+15555550142\">555-0142</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"mailto:hello@quillfern.example\">hello@quillfern.example</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:paragraph -->\n<p><a class=\"button\" href=\"http://127.0.0.1:9400/sample-site/services.html\">See services and prices</a></p>\n<!-- /wp:paragraph --></section>\n<!-- /wp:group --></main>\n<!-- /wp:group -->\n\n<!-- wp:group {\"tagName\":\"footer\"} -->\n<footer class=\"wp-block-group\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Quillfern Cycle Works</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>14 Ferrule Lane, Larkbend</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Pages</h2>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"http://127.0.0.1:9400/sample-site/about.html\">About</a></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"http://127.0.0.1:9400/sample-site/services.html\">Services</a>