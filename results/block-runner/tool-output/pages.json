        "stored_content": "<!-- wp:group {\"tagName\":\"header\"} -->\n<header class=\"wp-block-group\"><!-- wp:html -->\n<a class=\"brand\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\">\n        <img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/logo.svg\" alt=\"\" width=\"40\" height=\"40\">\n        Quillfern Cycle Works\n      <\/a>\n<!-- \/wp:html -->\n\n<!-- wp:html -->\n<button class=\"nav-toggle\" type=\"button\" aria-controls=\"site-nav\" aria-expanded=\"false\">Menu<\/button>\n<!-- \/wp:html -->\n\n<!-- wp:html -->\n<nav class=\"site-nav\" id=\"site-nav\" aria-label=\"Main\">\n        <ul>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\" aria-current=\"page\">Home<\/a><\/li>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\">About<\/a><\/li>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\">Services<\/a><\/li>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Contact<\/a><\/li>\n        <\/ul>\n      <\/nav>\n<!-- \/wp:html --><\/header>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"main\"} -->\n<main class=\"wp-block-group\"><!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Your bike, running like the day you got it<\/h1>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>A small repair workshop in Larkbend. Tune-ups, wheel builds and cargo bike care, done while you wait or by the next morning.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Book a repair<\/a><\/div>\n<!-- \/wp:button --><\/div>\n<!-- \/wp:buttons --><\/section>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">What we do<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Tune-ups<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Gears indexed, brakes set, chain cleaned and every bolt checked to torque.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:html -->\n<a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html#tune-ups\">See tune-up levels<\/a>\n<!-- \/wp:html --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wheels<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Truing, spoke replacement and hand-built wheels for road, gravel and town bikes.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:html -->\n<a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html#wheels\">See wheel work<\/a>\n<!-- \/wp:html --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Cargo bikes<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Longtails and front-loaders, with the space and the stands to work on them properly.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:html -->\n<a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html#cargo\">See cargo care<\/a>\n<!-- \/wp:html --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/section>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Open today<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:html -->\n<p class=\"open-row\">\n          <svg class=\"icon-wrench\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" role=\"img\" aria-labelledby=\"wrench-title\">\n            <title id=\"wrench-title\">Wrench icon<\/title>\n            <circle cx=\"24\" cy=\"24\" r=\"22\" fill=\"#e9a64b\"><\/circle>\n            <path d=\"M30 10a8 8 0 0 0-7.6 10.4L11 31.8 16.2 37l11.4-11.4A8 8 0 0 0 38 18l-5 2-4-4 2-5z\" fill=\"#1f4e5f\"><\/path>\n          <\/svg>\n          <span id=\"open-status\">The workshop is open Tuesday to Saturday, 9:00 to 17:30.<\/span>\n        <\/p>\n<!-- \/wp:html -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>They had my commuter back the same afternoon, and it shifts better than it did new.<\/p>\n<!-- \/wp:paragraph --><cite>A rider from Larkbend (a made-up quote for this test)<\/cite><\/blockquote>\n<!-- \/wp:quote --><\/section>\n<!-- \/wp:group --><\/main>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"footer\"} -->\n<footer class=\"wp-block-group\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Quillfern Cycle Works<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>14 Ferrule Lane, Larkbend<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Pages<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\">About<\/a><\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\">Services<\/a><\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Contact<\/a><\/li>\n<!-- \/wp:list-item --><\/ul>\n<!-- \/wp:list --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p>Quillfern Cycle Works is a fictional business, made for a software test.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\u00a9 <span class=\"year\">2026<\/span> Sample site, MIT licence.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/footer>\n<!-- \/wp:group -->"
