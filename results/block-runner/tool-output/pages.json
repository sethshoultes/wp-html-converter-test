        "stored_content": "<!-- wp:group {\"tagName\":\"header\"} -->\n<header class=\"wp-block-group\"><!-- wp:html -->\n<a class=\"brand\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\">\n        <img src=\"http:\/\/127.0.0.1:9400\/sample-site\/assets\/img\/logo.svg\" alt=\"\" width=\"40\" height=\"40\">\n        Quillfern Cycle Works\n      <\/a>\n<!-- \/wp:html -->\n\n<!-- wp:html -->\n<button class=\"nav-toggle\" type=\"button\" aria-controls=\"site-nav\" aria-expanded=\"false\">Menu<\/button>\n<!-- \/wp:html -->\n\n<!-- wp:html -->\n<nav class=\"site-nav\" id=\"site-nav\" aria-label=\"Main\">\n        <ul>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/index.html\">Home<\/a><\/li>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\">About<\/a><\/li>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\" aria-current=\"page\">Services<\/a><\/li>\n          <li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Contact<\/a><\/li>\n        <\/ul>\n      <\/nav>\n<!-- \/wp:html --><\/header>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"main\"} -->\n<main class=\"wp-block-group\"><!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Services and prices<\/h1>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Prices are fixed for labour. Parts are extra, and we tell you the part price before we fit anything. All prices are invented for this sample site.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:heading {\"anchor\":\"tune-ups\"} -->\n<h2 id=\"tune-ups\" class=\"wp-block-heading\">Tune-up levels<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:table -->\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><thead><tr><th scope=\"col\">Service<\/th><th scope=\"col\">What is included<\/th><th scope=\"col\">Time<\/th><th scope=\"col\">Price<\/th><\/tr><\/thead><tbody><tr><th scope=\"row\">Safety check<\/th><td>Brakes, tyres, bolts, chain wear<\/td><td>20 min<\/td><td>15<\/td><\/tr><tr><th scope=\"row\">Standard tune-up<\/th><td>Safety check, gears indexed, brakes adjusted, chain cleaned<\/td><td>1 hour<\/td><td>45<\/td><\/tr><tr><th scope=\"row\">Full service<\/th><td>Standard tune-up, bearings serviced, wheels trued, cables replaced<\/td><td>Next morning<\/td><td>110<\/td><\/tr><\/tbody><\/table><figcaption class=\"wp-element-caption\">Labour prices, in made-up sample currency.<\/figcaption><\/figure>\n<!-- \/wp:table --><\/section>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading {\"anchor\":\"wheels\"} -->\n<h2 id=\"wheels\" class=\"wp-block-heading\">Wheels and cargo bikes<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Wheel truing<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>A wobbly wheel trued on the stand, with spoke tension evened out.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Up to 3 spokes replaced<\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Same-day for most wheels<\/li>\n<!-- \/wp:list-item --><\/ul>\n<!-- \/wp:list --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Hand-built wheels<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Built to your rims and hubs, tensioned and stress-relieved.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Ready in five working days<\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Free re-true after a month<\/li>\n<!-- \/wp:list-item --><\/ul>\n<!-- \/wp:list --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Cargo bike care<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Longtails and front-loaders on our long stand, including steering and child-seat checks.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Booked slots only<\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Collection by arrangement<\/li>\n<!-- \/wp:list-item --><\/ul>\n<!-- \/wp:list --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/section>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"section\"} -->\n<section class=\"wp-block-group\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Check your chain at home<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Between visits, a chain checker tells you when a chain is worn. Here is the rule we use, written as code:<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:code -->\n<pre class=\"wp-block-code\"><code>\/\/ Chain wear, measured with a checker gauge.\nfunction chainAdvice(wearPercent) {\n  if (wearPercent >= 0.75) {\n    return 'Replace the chain, and check the cassette.';\n  }\n  if (wearPercent >= 0.5) {\n    return 'Replace the chain soon.';\n  }\n  return 'The chain is fine.';\n}<\/code><\/pre>\n<!-- \/wp:code -->\n\n<!-- wp:list {\"ordered\":true} -->\n<ol class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Shift to the smallest rear cog.<\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Drop the checker into the chain.<\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Read the gauge, then run the rule above.<\/li>\n<!-- \/wp:list-item --><\/ol>\n<!-- \/wp:list -->\n\n<!-- wp:paragraph -->\n<p><a class=\"button\" href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Book a service<\/a><\/p>\n<!-- \/wp:paragraph --><\/section>\n<!-- \/wp:group --><\/main>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"tagName\":\"footer\"} -->\n<footer class=\"wp-block-group\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Quillfern Cycle Works<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph -->\n<p>14 Ferrule Lane, Larkbend<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Pages<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/about.html\">About<\/a><\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/services.html\">Services<\/a><\/li>\n<!-- \/wp:list-item -->\n\n<!-- wp:list-item -->\n<li><a href=\"http:\/\/127.0.0.1:9400\/sample-site\/contact.html\">Contact<\/a><\/li>\n<!-- \/wp:list-item --><\/ul>\n<!-- \/wp:list --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p>Quillfern Cycle Works is a fictional business, made for a software test.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\u00a9 <span class=\"year\">2026<\/span> Sample site, MIT licence.<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/footer>\n<!-- \/wp:group -->"
